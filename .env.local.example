# Vercel and Cloudflare Pages need a public HTTPS NLI controller DNS origin;
# private IPs, EC2 .compute.internal names, and Supabase project URLs are not
# controller origins. Configure the hosted runtime instead of committing a
# value here.
NLI_CONTROLLER_ORIGIN=

# Supabase is accessed only by the authenticated Rocky controller. Do not put
# SUPABASE_SECRET_KEY, NLI_SUPABASE_CONTROLLER_SECRET, enrollment tokens, or
# any other controller/client secret in a Vercel or browser environment.
